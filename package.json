{
  "name": "@tradejs/strategy-value-area-reclaim",
  "version": "0.1.0",
  "description": "Causal reclaim of a completed UTC-day OHLCV value area.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "^3.1.28",
    "@tradejs/strategy-kit": "^3.0.6",
    "@tradejs/types": "^3.1.28",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@tradejs/core": "^3.1.28",
    "@tradejs/strategy-kit": "^3.0.6",
    "@tradejs/types": "^3.1.28"
  },
  "scripts": {
    "build": "tsup",
    "prettify": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "checks": "yarn format:check && yarn typecheck && yarn build && yarn test"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TradeJS-Dev/TradeJS-Strategy-ValueAreaReclaim.git"
  },
  "homepage": "https://github.com/TradeJS-Dev/TradeJS-Strategy-ValueAreaReclaim#readme",
  "bugs": {
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-ValueAreaReclaim/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
